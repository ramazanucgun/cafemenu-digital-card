# Server
PORT=3000
NODE_ENV=development
APP_URL=https://card.cafemenu.com.tr

# Independent PostgreSQL database for THIS project only.
# Must never point at the existing CafeMenu production database.
DATABASE_URL=postgres://user:password@localhost:5432/cafemenu_digital_card

# Auth
JWT_SECRET=replace-with-a-long-random-secret

# CORS - comma separated list of allowed origins
CORS_ORIGIN=https://card.cafemenu.com.tr

# Uploads
UPLOAD_DIR=uploads

# Cloudflare R2 (S3-compatible object storage) — required for profile/cover/logo image uploads.
# Without these, image upload endpoints return 503 but the rest of the app works normally.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=cafemenu-digital-card
# Public base URL for the bucket (R2.dev public URL or your own custom domain), no trailing slash.
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev
